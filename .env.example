# TalentAP Mega Hackathon 2026 - Environment Configuration Template (Rule 3)
# Copy this file to .env and configure local values. NEVER commit real .env to git.

# ----------------------------------------------------------------------------
# 1. Application Execution Mode
# ----------------------------------------------------------------------------
# Allowed modes:
#   - 'supabase'     : Production mode connecting to Supabase Auth & PostgreSQL
#   - 'local_dev'    : Local development mode using SQLite database
#   - 'offline_eval' : Dedicated offline evaluation mode (runs without any DB dependencies)
APP_MODE=supabase

# Environment Profile: 'production', 'development', or 'test'
APP_ENV=development
DEBUG=false

# ----------------------------------------------------------------------------
# 2. Supabase Cloud Configuration (Required when APP_MODE=supabase)
# ----------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Public Anon Key (safe for client-side API requests)
SUPABASE_ANON_KEY=your-supabase-anon-public-key
# Service Role Key (CONFIDENTIAL: local backend/CLI scripts only. NEVER commit or expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
# Expected JWT audience claim
SUPABASE_JWT_AUDIENCE=authenticated

# ----------------------------------------------------------------------------
# 3. Demonstration & Seed Configuration (Development/Evaluation Only)
# ----------------------------------------------------------------------------
# When true, seed scripts provision demonstration accounts. When false, demo accounts are blocked.
ENABLE_DEMO_ACCOUNTS=true

# Optional Synthetic Demo Credential Overrides (min 12 chars recommended)
# DEMO_ADMIN_PASSWORD=DemoAdmin#2026!HQSecure
# DEMO_MANAGER_PASSWORD=DemoMgr#2026!Kankarbagh
# DEMO_CUSTOMER_PASSWORD=DemoCust#2026!Aarav

# ----------------------------------------------------------------------------
# 4. Legacy Local Development Mode (SQLite - Active ONLY when APP_MODE=local_dev)
# ----------------------------------------------------------------------------
DATABASE_PATH=FULL_CODE/r5_store.db
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----------------------------------------------------------------------------
# 5. Security & CORS Origin Configuration
# ----------------------------------------------------------------------------
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
